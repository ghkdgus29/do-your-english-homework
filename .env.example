# 어드민(/admin) 비밀번호 — 이미지 업로드(=Claude 호출)는 어드민만 가능
ADMIN_PASSWORD=change-me
# 쿠키 서명 키: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Claude 인증 (둘 중 하나). `claude setup-token`으로 발급한 구독 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# 배포 서버 전용: Cloudflare Tunnel 토큰 (Zero Trust → Networks → Tunnels)
# TUNNEL_TOKEN=

# 선택
# CLAUDE_MODEL=
# DATA_DIR=data
# 로컬 http 개발 시 false
# COOKIE_SECURE=false
